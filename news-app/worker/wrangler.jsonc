{
  // Worker riêng của Bản tin NMH — không dùng chung với Ngố (nmh-voice-gpt-test).
  // database_id và GOOGLE_CLIENT_ID được workflow phát hành điền vào lúc deploy.
  "name": "nmh-news",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "d1_databases": [{ "binding": "DB", "database_name": "nmh-news", "database_id": "__D1_ID__", "migrations_dir": "../migrations" }],
  "vars": {
    "ALLOWED_EMAILS": "ai.nomahub@gmail.com",
    "DAILY_USD_LIMIT": "0.1",
    "MAX_CUSTOM_SOURCES": "10",
    "MONTHLY_USD_LIMIT": "3",
    "WEB_DAILY_LIMIT": "5"
  },
  "observability": { "enabled": true }
}
